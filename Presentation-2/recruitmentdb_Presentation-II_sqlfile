-- =========================
-- SELECT / QUERY COMMANDS
-- =========================

-- 1. Display applicants with their applied job titles.
-- (Uses job_title, which matches the working database.)
SELECT a.applicant_name, j.job_title
FROM applicant a
JOIN application ap ON a.applicant_id = ap.applicant_id
JOIN job j ON ap.job_id = j.job_id;

-- 2. Count applications by application status.
SELECT application_status, COUNT(*) AS total
FROM application
GROUP BY application_status;

-- 3. Find jobs with more than one applicant.
SELECT j.job_title, COUNT(ap.applicant_id) AS total
FROM job j
JOIN application ap ON j.job_id = ap.job_id
GROUP BY j.job_id, j.job_title
HAVING COUNT(ap.applicant_id) > 1;

