CREATE DATABASE IF NOT EXISTS recruitmentdb;
USE recruitmentdb;

-- =========================
-- TABLE CREATION
-- =========================

CREATE TABLE IF NOT EXISTS department (
    department_id INT PRIMARY KEY,
    department_name VARCHAR(100) NOT NULL
);

CREATE TABLE IF NOT EXISTS recruiter (
    recruiter_id INT PRIMARY KEY,
    recruiter_name VARCHAR(100) NOT NULL,
    email VARCHAR(120) UNIQUE,
    phone VARCHAR(20)
);

CREATE TABLE IF NOT EXISTS applicant (
    applicant_id INT PRIMARY KEY,
    applicant_name VARCHAR(80) NOT NULL,
    email VARCHAR(120) UNIQUE,
    phone VARCHAR(20),
    qualification VARCHAR(50),
    experience_years INT CHECK (experience_years >= 0)
);

CREATE TABLE IF NOT EXISTS job (
    job_id INT PRIMARY KEY,
    job_title VARCHAR(100) NOT NULL,
    department_id INT,
    recruiter_id INT,
    openings INT,
    salary DECIMAL(10,2),
    job_status VARCHAR(20),
    FOREIGN KEY (department_id) REFERENCES department(department_id),
    FOREIGN KEY (recruiter_id) REFERENCES recruiter(recruiter_id)
);

CREATE TABLE IF NOT EXISTS application (
    application_id INT PRIMARY KEY,
    applicant_id INT,
    job_id INT,
    application_date DATE,
    application_status VARCHAR(20) DEFAULT 'Pending',
    FOREIGN KEY (applicant_id) REFERENCES applicant(applicant_id),
    FOREIGN KEY (job_id) REFERENCES job(job_id)
);

CREATE TABLE IF NOT EXISTS interview (
    interview_id INT PRIMARY KEY,
    application_id INT,
    interview_date DATE,
    interview_mode VARCHAR(20),
    interview_result VARCHAR(20),
    FOREIGN KEY (application_id) REFERENCES application(application_id)
);

CREATE TABLE IF NOT EXISTS selection (
    selection_id INT PRIMARY KEY,
    application_id INT,
    selection_date DATE,
    decision VARCHAR(20),
    FOREIGN KEY (application_id) REFERENCES application(application_id)
);

-- Application tracking table present in the working database.
CREATE TABLE IF NOT EXISTS application_tracking (
    application_id INT,
    applicant_name VARCHAR(80),
    job_title VARCHAR(100),
    application_date DATE,
    application_status VARCHAR(20)
);

